# Virtual AI Companion - Environment Variables

# Option A: Groq Cloud API (Recommended: Free, Ultra-Fast ~300 tokens/sec, 0 CPU load)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini API (Free 1,500 requests/day)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Server Configuration (Optional)
PORT=8000
HOST=0.0.0.0
